# jbsnewmedia/vibe4dock-arcvd - example environment
# Copy to .env and fill in the values. Empty values = feature disabled.

# --- Ports ---
# Port Apache listens on inside the container. Must match the mapping in
# docker-compose.yml: "${HOST_HTTP_PORT}:${HTTP_PORT}".
HTTP_PORT=80

# HTTPS port inside the container. Empty = HTTPS disabled.
# Set e.g. 443 to enable HTTPS (same routing as HTTP; a self-signed
# certificate is generated on first start unless SSL_CERT_PATH/SSL_KEY_PATH
# are set). Then also uncomment the HTTPS mapping in docker-compose.yml.
HTTPS_PORT=

# Host-side ports (side of the Docker host):
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443

# Own TLS certificates, optional (e.g. mounted into the ./data volume);
# otherwise a self-signed certificate is generated on first start:
# SSL_CERT_PATH=/data/certs/cert.pem
# SSL_KEY_PATH=/data/certs/key.pem

# --- Routing ---
# Prefix for all service routes: /${VIBE_PREFIX}-chat, /${VIBE_PREFIX}-veronica, ...
# Allowed characters: a-z, 0-9, dash.
VIBE_PREFIX=vibe

# PWA app name (chat + veronica manifests) and start page title.
VIBE_NAME=Vibe4Dock

# Branding line shown as the persistent status bar inside the root/app shells:
# SHELL_HINT="Vibe4Dock AACV by JBS New Media | https://github.com/jbsnewmedia/vibe4dock-arcvd"

# --- Basic Auth ---
# Auth is only active when BOTH username and password are set.
# SITE_* protects the start page (DocumentRoot /) itself.
SITE_USERNAME=
SITE_PASSWORD=
CHAT_USERNAME=
CHAT_PASSWORD=
VERONICA_USERNAME=
VERONICA_PASSWORD=
ROOT_SHELL_USERNAME=
ROOT_SHELL_PASSWORD=
APP_SHELL_USERNAME=
APP_SHELL_PASSWORD=

# --- opencode ---
# Shared values for chat and veronica. Override per service with
# CHAT_OPENCODE_* / VERONICA_OPENCODE_*.
OPENCODE_API_KEY=
OPENCODE_PROVIDER=
OPENCODE_MODEL=
OPENCODE_AGENT=

# --- Vibe-Diff (git working tree UI, /${VIBE_PREFIX}-diff) ---
# Repo path inside the container; default: parent of the webroot (/app).
# VIBE_DIFF_REPO=/app/project
DIFF_USERNAME=
DIFF_PASSWORD=

# --- Veronica ---
# Allow registration in the UI (1/0)
VERONICA_ALLOW_REGISTRATION=1
# User DB seed: only used when /data/veronica-users.json does not exist yet.
# Afterwards the JSON file owns the users (managed in the UI or via API).
# The UI hashes PINs salted (veronica:<alias>:<pin>) - easiest is to pass the
# raw PIN here; it is salted automatically on first start.
# Pre-computed example for alias "adm" + PIN "1234":
#   printf 'veronica:adm:1234' | sha256sum
VERONICA_BOOTSTRAP_ADMIN=adm
VERONICA_BOOTSTRAP_ADMIN_PIN_HASH=1234
VERONICA_BOOTSTRAP_USERS=
