#!/bin/sh
# vibe4dock: opencode-API-Auth fuer den Apache-Proxy installieren (root-only).
#
# opencode v2 schuetzt seine Server-API mit HTTP Basic Auth und erzeugt bei
# jedem Serverstart ein Zufalls-Passwort ("server password ..." im Log). Die
# opencode-Prozess-Wrapper (user application) extrahieren es und rufen diesen
# Helper per sudo auf; er schreibt ein Apache-<Location>-Fragment, das den
# Authorization-Header fuer den API-Proxy setzt, und laedt Apache neu.
#
# Usage: vibe-auth-update <location-path> <basic-base64>
#   z.B. vibe-auth-update /v-example-chat/api/ b3ViZXI6...
set -e

LOC="$1"
B64="$2"

if [ -z "$LOC" ] || [ -z "$B64" ]; then
    echo "usage: vibe-auth-update <location-path> <basic-base64>" >&2
    exit 1
fi
# Beide Argumente landen in einer Apache-Config - streng validieren.
case "$LOC" in
    *[!a-zA-Z0-9/_.-]*|'') echo "vibe-auth-update: ungueltiger Location-Pfad" >&2; exit 1;;
esac
case "$B64" in
    *[!a-zA-Z0-9+/=]*|'') echo "vibe-auth-update: ungueltiges Base64" >&2; exit 1;;
esac

NAME=$(printf '%s' "$LOC" | tr -c 'a-zA-Z0-9' '_' | sed 's/_*$//')
CONF="/etc/vibe/auth/${NAME}.conf"
mkdir -p /etc/vibe/auth

cat > "$CONF" <<EOF
# Generated by vibe-auth-update (opencode serve password) - do not edit.
<Location "$LOC">
    RequestHeader set Authorization "Basic $B64"
</Location>
EOF
chmod 644 "$CONF"

# Apache neu laden, bis es klappt (beim Containerstart konkurriert der Helper
# mit dem Apache-Start; ohne Reload bleibt der API-Proxy unauthentifiziert).
i=0
while [ $i -lt 30 ]; do
    if apache2ctl graceful >/dev/null 2>&1; then
        exit 0
    fi
    i=$((i + 1))
    sleep 1
done
echo "vibe-auth-update: apache2ctl graceful fehlgeschlagen ($CONF)" >&2
exit 1
